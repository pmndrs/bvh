{
    "name": "@pmndrs/bvh",
    "version": "0.1.0-alpha.0",
    "description": "Engine-free WebGPU BVH: tinybvh in WebAssembly, GPU LBVH and H-PLOC builders, GPU refits, a WGSL ray walk with its CPU port, all writing one shared GPU layout.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pmndrs/bvh.git"
    },
    "homepage": "https://github.com/pmndrs/bvh#readme",
    "bugs": "https://github.com/pmndrs/bvh/issues",
    "type": "module",
    "sideEffects": false,
    "packageManager": "pnpm@10.23.0",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./worker": {
            "types": "./dist/worker/index.d.ts",
            "import": "./dist/worker/index.js",
            "default": "./dist/worker/index.js"
        },
        "./three": {
            "types": "./dist/three/index.d.ts",
            "import": "./dist/three/index.js",
            "default": "./dist/three/index.js"
        },
        "./babylon": {
            "types": "./dist/babylon/index.d.ts",
            "import": "./dist/babylon/index.js",
            "default": "./dist/babylon/index.js"
        }
    },
    "scripts": {
        "build": "node scripts/build.mjs && node scripts/verify-artifacts.mjs",
        "verify:dist": "node scripts/verify-artifacts.mjs",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.examples.json && tsc --noEmit -p tsconfig.snippets.json",
        "test": "vitest run",
        "test:gpu": "node tests/gpu/run.ts",
        "test:gpu:page": "node tests/gpu/run.ts --filter",
        "examples:dev": "vite --config examples/vite.config.ts",
        "examples:build": "vite build --config examples/vite.config.ts",
        "examples:smoke": "node tests/gpu/run.ts --examples",
        "examples:bake": "node --experimental-transform-types --no-warnings --import ./compare/node/register.mjs examples/node/bake/cli.ts",
        "compare:node": "node --max-old-space-size=24000 --experimental-transform-types --no-warnings --import ./compare/node/register.mjs compare/node/run.ts",
        "bvh:wasm": "node native/build-wasm.ts",
        "docs:api": "typedoc",
        "docs:snippets": "node tools/docs-snippets.ts",
        "docs:check": "node tools/docs-snippets.ts --check",
        "docs:site": "node tools/docs-site.ts",
        "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
    },
    "devDependencies": {
        "@babylonjs/core": "9.35.0",
        "@dimforge/rapier3d-compat": "0.21.0",
        "@eslint/js": "^9.39.5",
        "@types/node": "24.19.2",
        "@types/three": "0.187.0",
        "@webgpu/types": "^0.1.64",
        "bvh-tree": "1.0.1",
        "bvh.js": "0.0.13",
        "eslint": "^9.39.5",
        "globals": "^17.14.0",
        "three": "0.187.0",
        "three-mesh-bvh": "0.9.18",
        "typedoc": "^0.28.20",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.72.2",
        "vite": "^6.1.0",
        "vitest": "^3.0.0"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "licenses",
        "THIRD_PARTY.md",
        "README.md"
    ],
    "peerDependencies": {
        "@babylonjs/core": ">=9.35.0 <10.0.0",
        "three": ">=0.187.0 <0.188.0"
    },
    "peerDependenciesMeta": {
        "@babylonjs/core": {
            "optional": true
        },
        "three": {
            "optional": true
        }
    }
}
