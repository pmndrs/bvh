{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "dist",
        "rootDir": "src",
        "rewriteRelativeImportExtensions": true,
        "allowImportingTsExtensions": false,
        "removeComments": false,
        "declaration": true,
        "declarationMap": false,
        "sourceMap": false,
        "types": ["@webgpu/types"]
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.ts", "node_modules", "dist"]
}
