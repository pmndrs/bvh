{
    "$schema": "https://typedoc.org/schema.json",
    "name": "@pmndrs/bvh",
    "entryPoints": ["src/index.ts", "src/three/index.ts", "src/babylon/index.ts", "src/worker/index.ts"],
    "tsconfig": "tsconfig.json",
    "out": "api-docs",
    "readme": "none",
    "includeVersion": false,
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "excludeExternals": true,
    "exclude": ["**/*.test.ts"],
    "sort": ["kind", "alphabetical"],
    "navigationLinks": {
        "Docs": "https://pmndrs.github.io/bvh/",
        "GitHub": "https://github.com/pmndrs/bvh"
    },
    "validation": {
        "notExported": false,
        "invalidLink": false,
        "rewrittenLink": false,
        "unusedMergeModuleWith": false
    },
    "treatWarningsAsErrors": false
}
